# ============================================================
# 飞书科研闭环 Agent 环境模板（Phase 10 T7，ADR-0030）
# 复制为 .env 后填写；校验：python scripts/config_check.py --env-file .env
# 分组：必填（飞书/LLM/DB）→ 可选（业务默认）→ 测试专用
# ============================================================

# ---------- 必填：飞书应用凭据（开放平台 > 企业自建应用） ----------
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 事件订阅验签密钥：仅 webhook 模式需要；长连接模式（推荐，ADR-0031）可不填
FEISHU_WEBHOOK_SECRET=test_secret

# ---------- 可选：飞书子系统凭据（不设则对应 API 返回 not configured） ----------
# 评论闭环已 SDK 化零凭据（ADR-0032），仅需后台订阅 drive.notice.comment_add_v1
# Base 投影 / Drive 上传 / 公共模板审核管理员（逗号分隔）
# FEISHU_BASE_APP_TOKEN=
# FEISHU_DRIVE_PARENT_TOKEN=
# FEISHU_ADMIN_OPEN_IDS=

# ---------- 必填：LLM 路由（主/备，orchestrator/llm_router.py） ----------
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=sk-xxxxxxxx
LLM_PRIMARY_MODEL=deepseek-chat

LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_API_KEY=sk-xxxxxxxx
LLM_FALLBACK_MODEL=qwen-plus

# ---------- 可选：Phase 30 可视化模型切换（/model 管理命令卡） ----------
# admin 名单复用上方 FEISHU_ADMIN_OPEN_IDS（逗号分隔；空 = 无人可切换，安全默认）
# 加切换候选：config/llm.yaml providers 段加条目 + 此处加三个变量，例如
# LLM_PROVIDER_KIMI_BASE_URL=https://api.moonshot.cn/v1
# LLM_PROVIDER_KIMI_API_KEY=sk-xxxxxxxx
# LLM_PROVIDER_KIMI_MODEL=kimi-k2-0711-preview

# ---------- 必填：数据库 ----------
# 生产/联调用 PG；注意 SQLAlchemy 走 psycopg3 需 +psycopg 方言前缀
# 本地开发也可降级 sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# ---------- 可选：业务参数（缺省用 config/settings.py 默认值） ----------
BIND_DOC_TTL_SEC=1800
GATEWAY_RATE_LIMIT_PER_MIN=60
# Phase 9：评论自动同步轮询间隔（秒）
COMMENT_SYNC_INTERVAL_SEC=300
# Phase 9：全量评论提醒开关（1=所有新评论都推；默认 0 只推含指令评论）
COMMENT_NOTIFY_ALL=0
# Phase 12：研究任务执行（/research 后台线程整体超时秒数、DAG 并发节点数）
RESEARCH_TASK_TIMEOUT_SEC=300
MAX_CONCURRENT_NODES=4
# Phase 13 T2：沙箱执行（run_python 容器内真实执行）
# 镜像构建：docker build -t feishu-research-agent/kernel:latest sandbox -f sandbox/kernel.Dockerfile
DOCKER_IMAGE=feishu-research-agent/kernel:latest
KERNEL_EXEC_TIMEOUT_SEC=60
KERNEL_IDLE_TIMEOUT_SEC=1800
# DOCKER_CPU_LIMIT=1.0
# DOCKER_MEMORY_LIMIT=512m
# DOCKER_PIDS_LIMIT=64
# DOCKER_NETWORK_MODE=none

# ---------- 测试专用（不影响运行时） ----------
# pg 层测试库（docker compose up -d postgres，ADR-0029）；不设且连不上则自动 skip
PG_TEST_URL=postgresql+psycopg://agent:agent@localhost:5433/agent
